#!/usr/bin/env bash
# pr [-p <ref>] <repo> <message> [branch]: commits the index of a
# repository with a message file, on a new branch when on main; fails on
# any change not staged, untracked files too, for a review of the diff:
# what was forgotten is staged, what is not to go is stashed by the
# caller; pushes it and opens
# its pull request, the message without its trailer as the description,
# unless it is open. -p: "Part of <ref>." ends the description, a design or
# a pull request of another repository, which GitHub links back.
source "$(dirname "$0")/lib.sh"
part_of=
while getopts p: opt; do
    case $opt in
        p) part_of=$OPTARG ;;
        *) die "usage: pr [-p <ref>] <repo> <message> [branch]" ;;
    esac
done
shift $((OPTIND - 1))
msg=$(realpath "$2")
enter "$1"
"$meta/hooks/commit-msg" "$msg" || exit 1
unstaged=$(git status --porcelain | grep -v '^[MADRCT] ' || true)
[ -z "$unstaged" ] || die "$name: not staged, stage or stash it:
$unstaged"
! git diff --cached --quiet || die "$name: nothing staged"
branch=$(git branch --show-current)
if [ "$branch" = main ]; then
    [ -n "${3:-}" ] || die "on main: name a branch"
    branch=$3
    git switch -q -c "$branch"
fi
git diff --cached --name-status
net git fetch -q --prune
git merge-base --is-ancestor origin/main HEAD || die "$name: behind origin/main"
target=check; [ "$1" = . ] && target=check-prototypes
log=$(mktemp)
make "$target" > "$log" 2>&1 || { tail -30 "$log"; die "make $target failed: $log"; }
# -n: the hooks would only repeat the checks above
git -c user.email="$(git -C "$meta" config user.email)" commit -q -n -F "$msg"
net git push -q -u origin "$branch" \
    2> >(grep -vE '^remote: *($|Create a pull request|https://github.com/.*/pull/new/)' >&2)
if net gh pr view "$branch" --json url --jq .url 2> /dev/null; then
    exit  # a commit more of an open pull request
fi
body=$(mktemp)
{
    sed '1,2d; /^Co-Authored-By:/d' "$msg" \
        | awk 'NF {for (; n; n--) print ""; print; next} {n++}'
    [ -z "$part_of" ] || printf '\nPart of %s.\n' "$part_of"
    printf '\n🤖 Generated with [Claude Code](https://claude.com/claude-code)\n'
} > "$body"
net gh pr create --base main --head "$branch" --title "$(head -1 "$msg")" \
    --body-file "$body"
