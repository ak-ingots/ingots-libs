# Meta repository: everything here is ignored except its own files.
# Sibling directories are independent repositories (see repos.txt).
/*
!/.gitignore
!/README.md
!/CLAUDE.md
!/llms.txt
!/repos.txt
!/Makefile
!/.github/
!/.claude/
/.claude/*
!/.claude/settings.json
!/scripts/
!/perf/
!/hooks/
!/docs/

.idea/
.vscode/
.DS_Store
__pycache__/
.mypy_cache/
tasks
