#!/usr/bin/env python3
"""
perf/check-host [--system-cpus CPUS]: the host of a run of the load, its
state a line on stdout, for the report; why a run refuses to start on
stderr, exiting 1: the boost on, the IDE on the server, Claude Code off
the cores of the system, the memory short.
"""

import argparse
import os
import pathlib
import platform
import sys

# what a run refuses below: the memory available, in KiB
MIN_AVAILABLE_KIB = 2 * 1024 * 1024

# the IDE connected to the server, which a run wants off
IDE_MARKERS = ("JetBrains/RemoteDev", "pycharm")

# Claude Code, which takes up to a third of a CPU while it works: allowed
# on the cores of the system alone, PERF_SYSTEM_CPUS
AGENT_COMM = "claude"


def read_file(path: str) -> str:
    try:
        return pathlib.Path(path).read_text().strip()
    except OSError:
        return "?"


def parse_cpus(text: str) -> frozenset[int]:
    """The CPUs of a list as taskset takes it: ``0-1``, ``0,2,4-5``."""
    cpus: set[int] = set()
    for part in filter(None, text.split(",")):
        first, _, last = part.partition("-")
        cpus.update(range(int(first), int(last or first) + 1))
    return frozenset(cpus)


def get_affinity(pid: int) -> frozenset[int]:
    """The CPUs of a process; one gone meanwhile, none."""
    try:
        return frozenset(os.sched_getaffinity(pid))
    except OSError:
        return frozenset()


def main() -> None:
    parser = argparse.ArgumentParser(prog="perf/check-host")
    parser.add_argument("--system-cpus", default="0-1")
    args = parser.parse_args()
    cpu = "?"
    for line in read_file("/proc/cpuinfo").splitlines():
        if line.startswith("model name"):
            cpu = line.split(":", 1)[1].strip()
            break
    meminfo = dict(
        line.split(":", 1) for line in read_file("/proc/meminfo").splitlines()
    )
    available = int(meminfo.get("MemAvailable", "0 kB").split()[0])
    boost = read_file("/sys/devices/system/cpu/cpufreq/boost")
    epp = read_file("/sys/devices/system/cpu/cpu0/cpufreq/energy_performance_preference")
    pids = [pid for pid in os.listdir("/proc") if pid.isdigit()]
    ide = [p for p in pids if any(m in read_file(f"/proc/{p}/cmdline") for m in IDE_MARKERS)]
    system = parse_cpus(args.system_cpus)
    agents = [p for p in pids if read_file(f"/proc/{p}/comm") == AGENT_COMM]
    loose = [p for p in agents if not get_affinity(int(p)) <= system]
    agent = "loose" if loose else "pinned" if agents else "off"
    state = (
        f"{cpu}; kernel {platform.release()}; boost {boost}; epp {epp};"
        f" available {available // 1024} MiB; ide {'on' if ide else 'off'};"
        f" claude {agent}"
    )
    print(state)
    refusals = []
    if boost != "0":
        refusals.append("the boost is on: sudo perf/tune-host on")
    if ide:
        refusals.append("the IDE is running on the server: close it")
    for pid in loose:
        refusals.append(
            f"Claude Code runs off the system cores: taskset -apc {args.system_cpus} {pid}"
        )
    if available < MIN_AVAILABLE_KIB:
        refusals.append(f"{available // 1024} MiB available, under 2 GiB")
    for refusal in refusals:
        print(f"refused: {refusal}", file=sys.stderr)
    sys.exit(1 if refusals else 0)


if __name__ == "__main__":
    main()
