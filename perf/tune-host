#!/usr/bin/env bash
# perf/tune-host on|off, as root: the CPU of the dev server steady for a run
# of the load, its boost off and every core at the preference of
# performance; off gives back the boost and balance_performance.
set -euo pipefail
case ${1:-} in
    on) boost=0; epp=performance ;;
    off) boost=1; epp=balance_performance ;;
    *) echo "usage: $0 on|off" >&2; exit 2 ;;
esac
[ "$(id -u)" = 0 ] || { echo "run as root: sudo $0 $1" >&2; exit 1; }
echo $boost > /sys/devices/system/cpu/cpufreq/boost
for f in /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference; do
    echo $epp > "$f"
done
echo "boost $(cat /sys/devices/system/cpu/cpufreq/boost)," \
    "epp $(cat /sys/devices/system/cpu/cpu0/cpufreq/energy_performance_preference)"
